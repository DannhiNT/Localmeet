<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LocalMeet</title>
  <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
  <link href="{{ url_for('static', filename='style.css') }}" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
  <script defer src="{{ url_for('static', filename='script.js') }}"></script>
</head>

<body>
  <nav class="navbar is-white has-shadow" role="navigation" aria-label="main navigation">
    <div class="container">
      <div class="is-flex ">
        <a class="navbar-item is-size-5 has-text-weight-bold localmeet-textlogo"
          href="{{ url_for('events.event_list') }}">
          ✿ LocalMeet ✿
        </a>

        <!-- Hamburger menu for mobile -->
        <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarMain">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </a>
      </div>

      <div id="navbarMain" class="navbar-menu">
        <div class="navbar-start">
          <a class="navbar-item has-text-weight-medium" href="{{ url_for('events.event_list') }}">
            Events
          </a>
          {% if current_user.is_authenticated %}
          <a class="navbar-item has-text-weight-medium" href="{{ url_for('events.new_event_form') }}">
            Create Event
          </a>
          {% endif %}
        </div>

        <div class="navbar-end">
          {% if current_user.is_authenticated %}
          <div class="navbar-item has-dropdown is-hoverable">
            <a class="navbar-link has-text-weight-medium">
              {{ current_user.first_name }}
            </a>
            <div class="navbar-dropdown is-right">
              <a class="navbar-item" href="{{ url_for('user.user_profile', user_id=current_user.id) }}">
                My Profile
              </a>
              <a class="navbar-item" href="{{ url_for('user.posted_event_list') }}">
                My Events
              </a>
              <a class="navbar-item" href="{{ url_for('user.registered_event_list') }}">
                Registered Events
              </a>
              <hr class="navbar-divider">
              <a class="navbar-item has-text-danger" href="{{ url_for('auth.logout') }}">
                Logout
              </a>
            </div>
          </div>
          {% else %}
          <div class="navbar-item">
            <a class="button is-primary is-rounded has-text-weight-semibold" href="{{ url_for('auth.login') }}">
              Sign In
            </a>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </nav>

  <section class="section">
    <div class="container">
      {% block content %} {% endblock content%}
    </div>
  </section>

  {% with messages = get_flashed_messages(with_categories=true) %}
  {% if messages %}
  <div class="flash-container" style="position: fixed; bottom: 1rem; right: 1rem; z-index: 2000;">
    {% for category, message in messages %}
    <div class="notification flash-notification is-{{ category }} has-text-weight-semibold p-3"
      style="border-radius: 8px; min-width: 200px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
      {{ message }}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endwith %}

  <script>
    // Mobile menu toggle
    document.addEventListener('DOMContentLoaded', () => {
      const $navbarBurgers = Array.prototype.slice.call(document.querySelectorAll('.navbar-burger'), 0);
      if ($navbarBurgers.length > 0) {
        $navbarBurgers.forEach(el => {
          el.addEventListener('click', () => {
            const target = el.dataset.target;
            const $target = document.getElementById(target);
            el.classList.toggle('is-active');
            $target.classList.toggle('is-active');
          });
        });
      }
    });

    // Automate flash message disappear
    setTimeout(() => {
      document.querySelectorAll('.flash-notification').forEach(noti => {
        noti.style.transition = "opacity 0.5s";
        noti.style.opacity = "0";
        setTimeout(() => noti.remove(), 500);
      });
    }, 2500);
  </script>
</body>

</html>