{% extends 'base.jinja' %}

{% block content %}
<section class="section">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-8-desktop is-10-tablet">
        <h1 class="title is-3 has-text-centered mb-5">
          {% if event %}Edit Event{% else %}Create New Event{% endif %}
        </h1>

        <form method="POST" action="{{ form_action }}" enctype="multipart/form-data">

          <div class="field">
            <label class="label" for="title">Title</label>
            <div class="control">
              <input class="input" type="text" id="title" name="title" {% if event %} value="{{ event.title }}" {% endif
                %} required placeholder=" ">
            </div>
          </div>

          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label" for="date">Date</label>
                <div class="control">
                  <input class="input" type="date" id="date" name="date" {% if event %} value="{{ event.date }}" {%
                    endif %} required>
                </div>
              </div>
            </div>

            <div class="column">
              <div class="field">
                <label class="label" for="time">Time</label>
                <div class="control">
                  <input class="input" type="time" id="time" name="time" {% if event %} value="{{ event.time }}" {%
                    endif %} required>
                </div>
              </div>
            </div>
          </div>

          <div class="field">
            <label class="label" for="location">Location</label>
            <div class="control has-icons-left">
              <input class="input" type="text" id="location" name="location" {% if event %} value="{{ event.location }}"
                {% endif %} required placeholder=" ">
              <span class="icon is-small is-left">
                <i class="fas fa-map-marker-alt"></i>
              </span>
            </div>
          </div>

          <div class="field">
            <label class="label" for="cover_image">Cover Image</label>
            <div class="control">
              <div class="file has-name is-fullwidth">
                <label class="file-label">
                  <input class="file-input" type="file" id="cover_image" name="cover_image" accept="image/*" {% if not
                    event %} required {% endif %}>
                  <span class="file-cta">
                    <span class="file-icon">
                      <i class="fas fa-upload"></i>
                    </span>
                    <span class="file-label">
                      Choose a file…
                    </span>
                  </span>
                  <span class="file-name" id="file-name">
                    {% if event and event.cover_image_path %}
                    {{ event.cover_image_path.split("/")[-1] }}
                    {% else %}
                    No file uploaded
                    {% endif %}
                  </span>
                </label>
              </div>
            </div>
          </div>

          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label" for="price">Price ($)</label>
                <div class="control has-icons-left">
                  <input class="input" type="number" id="price" step="0.01" name="price" {% if event %}
                    value="{{ event.price }}" {% endif %} min="0">
                  <span class="icon is-small is-left">
                    <i class="fas fa-dollar-sign"></i>
                  </span>
                </div>
              </div>
            </div>

            <div class="column">
              <div class="field">
                <label class="label" for="max_attendees">Max Attendees</label>
                <div class="control has-icons-left">
                  <input class="input" type="number" id="max_attendees" name="max_attendees" {% if event %}
                    value="{{ event.max_attendees }}" {% endif %} min="0">
                  <span class="icon is-small is-left">
                    <i class="fas fa-users"></i>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="field">
            <label class="label" for="short_description">Short Description</label>
            <div class="control">
              <input class="input" id="short_description" name="short_description" maxlength="50"
                placeholder="Max 50 characters" {% if event %} value="{{ event.short_description }}" {% endif %}
                placeholder=" " required>
            </div>
          </div>

          <div class="field">
            <label class="label">Event Details</label>
            <div class="control">
              <div id="editor"></div>
              <input type="hidden" name="details" id="details">
            </div>
          </div>

          <div class="field">
            <label class="label" for="registration_deadline">Registration Deadline</label>
            <div class="control has-icons-left">
              <input class="input" type="datetime-local" id="registration_deadline" name="registration_deadline" {% if
                event %} value="{{ event.registration_deadline }}" {% endif %} required>
              <span class="icon is-small is-left">
                <i class="fas fa-calendar-check"></i>
              </span>
            </div>
          </div>
          <div class="field is-grouped is-grouped-centered mt-5">
            <div class="control">
              <button type="submit" class="button is-info is-medium">
                <strong>
                  {% if event %}
                  Update Event
                  {% else %}
                  Create Event
                  {% endif %}
                </strong>
              </button>
            </div>
            <div class="control">
              <a href="{{ url_for('events.event_list') }}" class="button is-link is-light is-medium">
                Cancel
              </a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Include the Quill library -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

<!-- Initialize Quill editor and save data -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const quill = new Quill('#editor', {
      theme: 'snow'
    });

    {% if event_details %}
    const delta = {{ event_details | tojson | safe
  }};
  quill.setContents(delta);
  {% endif %}

  const form = document.querySelector('form');
  form.onsubmit = function () {
    document.querySelector('#details').value = JSON.stringify(quill.getContents());
  };
  });
</script>

<script>
  // File input name display
  const fileInput = document.getElementById('cover_image');
  if (fileInput) {
    fileInput.addEventListener('change', function (e) {
      const fileName = e.target.files[0]?.name || 'No file uploaded';
      document.getElementById('file-name').textContent = fileName;
    });
  }
</script>
{% endblock content %}