{% extends 'base.jinja' %}

{% block content %}
<section class="section">
  <div class="container">
    <div class="box p-6" style="max-width: 800px; margin: auto;">
      <!-- User Info -->
      <div class="media is-flex is-align-items-center">
        <div class="media-left">
          <figure class="image is-64x64">
            <img class="is-rounded" src="{{event.host.profile_image_path}}" alt="User Image">
          </figure>
        </div>
        <div class="media-content has-text-weight-semibold is-size-5">
          Posted by: {{ event.host.first_name }} {{ event.host.last_name }}
        </div>

      </div>

      <!-- Header Box -->
      <div class="is-flex is-align-items-center is-justify-content-center is-flex-direction-column">
        <!-- Title + Short Description -->
        <h1 class="title is-2 mt-4">{{ event.title }}</h1>
        <h2 class="subtitle is-4">{{ event.short_description }}</h2>

        <!-- Attendees -->
        <p class="is-size-5 mb-4">
          {% if current_user.is_authenticated and event.host==current_user %}
          <a id="open-attendees" class="has-text-link">
            <strong>{{ current_registrations }}</strong> / <strong>{{ event.max_attendees }}</strong> attendees
            registered
          </a>
          {% else %}
        <p class="has-text-link">
          <strong>{{ current_registrations }}</strong> / <strong>{{ event.max_attendees }}</strong> attendees registered
        </p>
        {% endif %}
        </p>
      </div>

      <hr>

      <!-- Cover Image -->
      <figure class="is-flex is-align-items-center is-justify-content-center details-event-image-frame">
        <img src="{{ event.cover_image_path }}" alt="Event Cover Image">
      </figure>

      <hr>

      <!-- Details -->
      <h2 class="title is-4">Event Details</h2>
      <div class="content mb-6">
        <div id="event-details-container"></div>
      </div>

      <!-- Ticket Price -->
      {% if event.price == 0 %}
      <h2 class="title is-4">Ticket price: Free</h2>
      {% else %}
      <h2 class="title is-4">Ticket price: <span>${{ event.price }}/person</span> </h2>
      {% endif %}

      <!-- Location and DateTime -->
      <h2 class="title is-4">Location and DateTime</h2>
      <div class="content mb-6">
        <ul>
          <li><strong>Location</strong>: {{ event.location }}</li>
          <li><strong>Date</strong>: {{ event.date.strftime("%a, %B %d, %Y") }}</li>
          <li><strong>Starting time</strong>: {{ event.time.strftime("%I:%M %p") }}</li>
        </ul>
      </div>

      <!-- Registration Deadline -->
      <div class="notification is-danger is-light has-text-centered is-size-5 mb-5">
        Registration Deadline: <strong>{{ event.registration_deadline.strftime("%d %B %Y, %I:%M %p") }}</strong>
      </div>

      <!-- Register Button -->
      <div class="has-text-centered mt-4">
        {% if not current_user.is_authenticated %}
        <a href="{{ url_for('auth.login') }}">
          <button class="button is-primary px-6">
            Login to Register
          </button>
        </a>
        {% elif current_user.is_authenticated and event.host==current_user %}
        <a href="{{url_for('events.edit_event', event_id=event.id)}}">
          <button class="button is-info is-light px-6">
            <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
            <span>Edit</span>
          </button>
        </a>
        <form method="POST" action="{{ url_for('events.delete_event', event_id=event.id) }}"
          onsubmit="return confirm('Are you sure you want to delete this event?')" class="is-inline">

          <button type="submit" class="button is-danger px-6">
            <span class="icon"><i class="fa-solid fa-trash"></i></span>
            <span>Delete</span>
          </button>
        </form>
        {% elif is_full and not user_registered %}
        <button class="button is-danger is-light px-6" disabled>
          Full
        </button>
        {% elif user_registered %}
        <p class="has-text-success has-text-weight-semibold mb-2">
          You have registered for this event.
        </p>
        <form method="POST" action="{{ url_for('events.deregister_from_event', event_id=event.id) }}"
          onsubmit="return confirm('Are you sure you want to withdraw registration from this event?')">
          <button class="button is-warning px-6">
            Withdraw
          </button>
        </form>
        {% else %}
        <form action="{{ url_for('events.register_for_event', event_id=event.id) }}" method="POST">
          <button class="button is-info px-6">
            <strong>Register Now</strong>
          </button>
        </form>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="modal" id="attendees-modal">
    <div class="modal-background"></div>

    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">Registered Attendees</p>
        <button class="delete" aria-label="close"></button>
      </header>

      <div class="modal-content modal-card-body">
        <div id="attendees-list">
          {% if event_registered_users %}
          <ul class="attendees-list">
            {% for registered_user in event_registered_users %}
            <li class="attendee-item">
              <strong>{{ registered_user.first_name }} {{ registered_user.last_name }}</strong>
              <span class="has-text-grey is-size-7">
                ({{ registered_user.email }})
              </span>
            </li>
            {% endfor %}
          </ul>
          {% else %}
          <p class="has-text-grey has-text-centered">No attendees registered yet.</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

<script>
  {% if event_details %}
  const deltaObject = {{ event_details | tojson | safe }};
  const tempQuill = new Quill(document.createElement("div"));
  tempQuill.setContents(deltaObject);
  const html = tempQuill.root.innerHTML;
  document.getElementById("event-details-container").innerHTML = html;
  {% endif %}

  const openBtn = document.getElementById("open-attendees");
  const modal = document.getElementById("attendees-modal");

  if (openBtn) {
    openBtn.addEventListener("click", () => {
      modal.classList.add("is-active");
    });
  }
  modal.querySelector(".delete").addEventListener("click", () => {
    modal.classList.remove("is-active");
  });
  modal.querySelector(".modal-background").addEventListener("click", () => {
    modal.classList.remove("is-active");
  });
</script>
{% endblock content %}