{% extends 'base.jinja' %}

{% block content %}
<section class="section">
  <div class="container">
    <h1 class="title">Edit Profile</h1>
    <form method="POST" enctype="multipart/form-data" action="{{ url_for('user.edit_user_profile', user_id=user.id) }}">

      <div class="field">
        <label class="label" for="first_name">First Name</label>
        <div class="control">
          <input class="input" type="text" id="first_name" name="first_name" value="{{ user.first_name }}">
        </div>
      </div>

      <div class="field">
        <label class="label" for="last_name">Last Name</label>
        <div class="control">
          <input class="input" type="text" id="last_name" name="last_name" value="{{ user.last_name }}">
        </div>
      </div>

      <div class="field">
        <label class="label" for="phone_number">Phone Number</label>
        <div class="control">
          <input class="input" type="text" id="phone_number" name="phone_number" value="{{ user.phone_number }}">
        </div>
      </div>

      <div class="field">
        <label class="label" for="location">Location</label>
        <div class="control">
          <input class="input" type="text" id="location" name="location" value="{{ user.location }}">
        </div>
      </div>

      <div class="field">
        <label class="label" for="bio">Bio</label>
        <div class="control">
          <textarea class="textarea" id="bio" name="bio">{{ user.bio }}</textarea>
        </div>
      </div>

      <div class="field">
        <label class="label" for="profile_image">Profile Image</label>
        <div class="control">
          <div class="file has-name is-fullwidth">
            <label class="file-label">
              <input class="file-input" type="file" id="profile_image" name="profile_image" accept="image/*" {% if not
                user %} required {% endif %}>
              <span class="file-cta">
                <span class="file-icon">
                  <i class="fas fa-upload"></i>
                </span>
                <span class="file-label">
                  Choose a file…
                </span>
              </span>
              <span class="file-name" id="file-name">
                {% if user and user.profile_image_path %}
                {{ user.profile_image_path.split("/")[-1] }}
                {% else %}
                No file uploaded
                {% endif %}
              </span>
            </label>
          </div>
        </div>
      </div>

      <div class="field is-grouped">
        <div class="control">
          <button class="button is-link" type="submit">Update Profile</button>
        </div>
        <div class="control">
          <a class="button is-light" href="{{ url_for('user.user_profile', user_id=user.id) }}">Cancel</a>
        </div>
      </div>

    </form>
  </div>
</section>
{% endblock content %}